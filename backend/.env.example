# AutoPilot — backend environment
#
# Copy to `.env` for local development:  cp .env.example .env
# `.env` is gitignored. Never commit real secrets.
# In production these are set in the Render dashboard, not in a file.

# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# ── Logging ───────────────────────────────────────────────────────────────────
# error | warn | info | http | debug
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# Local (docker-compose):
DATABASE_URL=postgresql://autopilot:autopilot@localhost:5432/autopilot?schema=public
# Neon (production) — always keep sslmode=require:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/autopilot?sslmode=require

# ── CORS ──────────────────────────────────────────────────────────────────────
# `*` for local dev; a comma-separated allowlist once the dashboard has a domain.
CORS_ORIGINS=*

# ── Automation ────────────────────────────────────────────────────────────────
# Hard ceiling on one automation run. Raise in Phase 3 — Playwright needs longer.
EXECUTION_TIMEOUT_MS=120000

# Shared secret for machine callers (GitHub Actions cron, Phase 2).
# Optional in Phase 1. Generate with: openssl rand -hex 32
# AUTOMATION_API_KEY=

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# ── Phase 3 (Playwright) — not read yet ───────────────────────────────────────
# NAUKRI_EMAIL=
# NAUKRI_PASSWORD=

# ── Phase 5 (email notifications) — not read yet ──────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFICATION_FROM=
# NOTIFICATION_TO=
