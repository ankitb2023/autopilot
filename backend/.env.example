# AutoPilot — copy to .env for local development:  cp .env.example .env
# .env is gitignored. On Render these are set in the dashboard, not in a file.

NODE_ENV=development
PORT=8080

# error | warn | info | debug
LOG_LEVEL=debug

# Neon — keep sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/autopilot?sslmode=require

# Hard ceiling on one automation run. Raise in Phase 3 — Playwright is slower.
EXECUTION_TIMEOUT_MS=120000

# Shared secret for the GitHub Actions cron trigger (Phase 2).
# Generate with: openssl rand -hex 32
# AUTOMATION_API_KEY=

# Phase 3 (Playwright) — not read yet
# NAUKRI_EMAIL=
# NAUKRI_PASSWORD=
