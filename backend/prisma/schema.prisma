// AutoPilot — data model
//
// Only what Phases 2–4 actually need. Settings, Users and Notifications arrive with
// the phases that use them; empty tables are just maintenance.
//
// Provider and action are stored as strings, not Postgres enums, so registering a
// new provider never requires a migration — the same principle the provider
// registry enforces in code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
  TIMEOUT
}

enum TriggerSource {
  API
  CRON
  MANUAL
}

/// One automation run. Written by the service in Phase 4, read by the dashboard later.
model ExecutionHistory {
  id String @id @default(uuid()) @db.Uuid

  provider String /// e.g. "naukri" — matches ProviderId in code
  action   String /// e.g. "profile.update"

  status  ExecutionStatus
  trigger TriggerSource   @default(API)

  /// The worker's message, or the failure reason.
  message String?

  /// Stable machine code on failure, so failures can be grouped without string
  /// matching.
  errorCode String?

  durationMs Int?

  /// Provider-specific payload: fields changed, screenshot paths (Phase 3).
  /// JSON because its shape is per-provider by nature.
  details Json?

  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)

  /// Indexed for the two real queries: a reverse-chronological feed, and
  /// "latest run for provider X".
  @@index([startedAt(sort: Desc)])
  @@index([provider, startedAt(sort: Desc)])
  @@map("execution_history")
}

/// Mutual-exclusion lease for automation runs — one row per lock key (per provider).
/// A concurrent run for the same key is rejected with 409 rather than driving a
/// second browser session into the same account.
///
/// See src/automation/execution.lock.ts for why this is a lease row rather than a
/// Postgres advisory lock.
model AutomationLock {
  /// Lock key, e.g. "naukri". Natural primary key: one row per lock by definition.
  key String @id

  /// The run holding the lease. Release only deletes its own row, so a run whose
  /// lease already expired cannot release its successor's lock.
  executionId String @db.Uuid

  /// Denormalised for readability when inspecting a live lock. Never used for locking.
  trigger TriggerSource @default(API)

  /// Timestamptz, unlike Prisma's default `timestamp(3)`. This is the one table
  /// written with raw SQL, and `now()` returns timestamptz — storing that into a
  /// tz-less column silently converts to the connection's local time and reads back
  /// as UTC, skewing the lease by the server's UTC offset.
  acquiredAt DateTime @default(now()) @db.Timestamptz(3)

  /// Lease expiry, always on the database clock. A crashed process's lock self-heals
  /// once this passes; nothing has to clean up after it.
  expiresAt DateTime @db.Timestamptz(3)

  @@map("automation_locks")
}
